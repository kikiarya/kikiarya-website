# Optional AI enhancement. Without these values, the assistant remains a local portfolio guide.
AI_GATEWAY_API_KEY=
AI_MODEL=

# Required before AI calls are enabled. Also backs shared limits and answer caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Use a long random value in production so visitor identifiers are not stored as raw IPs.
ASSISTANT_HASH_SECRET=

# Hard budget controls for model-backed answers.
ASSISTANT_DAILY_GLOBAL_LIMIT=100
ASSISTANT_MONTHLY_LIMIT=2500
